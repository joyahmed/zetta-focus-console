# =============================================================================
# Zetta Focus Console - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Lemon Squeezy Configuration
# -----------------------------------------------------------------------------
# Get these from your Lemon Squeezy dashboard: https://app.lemonsqueezy.com/

# Your Lemon Squeezy signing secret (for webhook signature verification)
# Found in: Settings -> API -> Webhook signing secret
LEMON_SQUEEZY_SIGNING_SECRET=your_signing_secret_here

# Your Lemon Squeezy store ID
LEMON_SQUEEZY_STORE_ID=your_store_id_here

# Checkout URLs (replace with your actual store slug)
LEMON_SQUEEZY_PRO_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/pro
LEMON_SQUEEZY_FOUNDER_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/founder
LEMON_SQUEEZY_STORE_URL=https://your-store.lemonsqueezy.com

# -----------------------------------------------------------------------------
# License Cryptographic Keys
# -----------------------------------------------------------------------------
# Generate these using the scripts/generate-license-keys.rs tool

# Ed25519 public key (32 bytes, hex-encoded)
# This is SAFE to include in client code - it can only verify, not sign
# Generate with: cargo run --features signing --bin generate-keys
LICENSE_PUBLIC_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Ed25519 private key (64 bytes, hex-encoded) - ONLY for backend signing service
# NEVER include this in client code!
# LICENSE_PRIVATE_KEY=... (only for backend)

# -----------------------------------------------------------------------------
# bKash Configuration (Bangladesh local payment)
# -----------------------------------------------------------------------------
BKASH_MERCHANT_NUMBER=+880-1XXXXXXXXX
BKASH_CONTACT_EMAIL=support@zettafocus.com

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
