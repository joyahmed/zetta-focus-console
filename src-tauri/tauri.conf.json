{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Zetta Focus Console",
	"version": "1.0.0",
	"identifier": "com.zetta.focus-console",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Zetta Focus Console",
				"width": 1500,
				"height": 1100,
				"minWidth": 1200,
				"minHeight": 800,
				"maxWidth": 1600,
				"maxHeight": 1100,
				"center": true,
				"resizable": true,
				"maximizable": true,
				"decorations": true,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
